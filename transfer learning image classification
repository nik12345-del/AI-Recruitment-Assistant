      "source": [
        "# ================================================================\n",
        "# FLOWER IMAGE CLASSIFICATION USING TRANSFER LEARNING\n",
        "# PRE-TRAINED MODEL: MobileNetV2\n",
        "# GOOGLE COLAB - COMPLETE CODE\n",
        "# ================================================================\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 1. IMPORT LIBRARIES\n",
        "# ================================================================\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "\n",
        "from tensorflow.keras import layers, models\n",
        "from google.colab import files\n",
        "from PIL import Image\n",
        "\n",
        "print(\"================================================\")\n",
        "print(\"FLOWER CLASSIFICATION USING MOBILENETV2\")\n",
        "print(\"================================================\")\n",
        "\n",
        "print(\"TensorFlow Version:\", tf.__version__)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 2. DOWNLOAD FLOWER DATASET\n",
        "# ================================================================\n",
        "\n",
        "dataset_url = \"https://storage.googleapis.com/download.tensorflow.org/example_images/flower_photos.tgz\"\n",
        "\n",
        "print(\"\\nDownloading flower dataset...\")\n",
        "\n",
        "data_dir = tf.keras.utils.get_file(\n",
        "    \"flower_photos\",\n",
        "    origin=dataset_url,\n",
        "    untar=True\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# IMPORTANT:\n",
        "# TensorFlow may extract the dataset as:\n",
        "#\n",
        "# flower_photos/\n",
        "#       flower_photos/\n",
        "#             daisy/\n",
        "#             dandelion/\n",
        "#             roses/\n",
        "#             sunflowers/\n",
        "#             tulips/\n",
        "#\n",
        "# So we check for the inner folder.\n",
        "# ------------------------------------------------\n",
        "\n",
        "inner_folder = os.path.join(data_dir, \"flower_photos\")\n",
        "\n",
        "if os.path.isdir(inner_folder):\n",
        "    data_dir = inner_folder\n",
        "\n",
        "print(\"\\nDataset path:\")\n",
        "print(data_dir)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 3. CHECK DATASET FOLDERS\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"CHECKING DATASET\")\n",
        "print(\"================================================\")\n",
        "\n",
        "folders = sorted([\n",
        "    folder for folder in os.listdir(data_dir)\n",
        "    if os.path.isdir(os.path.join(data_dir, folder))\n",
        "])\n",
        "\n",
        "print(\"\\nFlower folders found:\")\n",
        "\n",
        "for folder in folders:\n",
        "    print(\" -\", folder)\n",
        "\n",
        "print(\"\\nNumber of flower categories:\", len(folders))\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 4. IMAGE PARAMETERS\n",
        "# ================================================================\n",
        "\n",
        "IMG_SIZE = 224\n",
        "BATCH_SIZE = 32\n",
        "SEED = 123\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 5. LOAD TRAINING DATASET\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"LOADING TRAINING DATA\")\n",
        "print(\"================================================\")\n",
        "\n",
        "train_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    data_dir,\n",
        "    validation_split=0.20,\n",
        "    subset=\"training\",\n",
        "    seed=SEED,\n",
        "    image_size=(IMG_SIZE, IMG_SIZE),\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 6. LOAD VALIDATION DATASET\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"LOADING VALIDATION DATA\")\n",
        "print(\"================================================\")\n",
        "\n",
        "val_ds = tf.keras.utils.image_dataset_from_directory(\n",
        "    data_dir,\n",
        "    validation_split=0.20,\n",
        "    subset=\"validation\",\n",
        "    seed=SEED,\n",
        "    image_size=(IMG_SIZE, IMG_SIZE),\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 7. GET FLOWER CLASS NAMES\n",
        "# ================================================================\n",
        "\n",
        "class_names = train_ds.class_names\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"FLOWER CATEGORIES\")\n",
        "print(\"================================================\")\n",
        "\n",
        "for i, name in enumerate(class_names):\n",
        "    print(f\"{i} : {name}\")\n",
        "\n",
        "print(\"\\nTotal number of classes:\", len(class_names))\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 8. VERIFY THAT THERE ARE MULTIPLE CLASSES\n",
        "# ================================================================\n",
        "\n",
        "if len(class_names) < 2:\n",
        "    raise ValueError(\n",
        "        \"\\nERROR: Only one class was detected!\\n\"\n",
        "        \"Check the dataset directory structure.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nDataset correctly contains multiple flower categories.\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 9. DISPLAY SAMPLE IMAGES\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\nDisplaying sample flower images...\")\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "for images, labels in train_ds.take(1):\n",
        "\n",
        "    for i in range(min(9, len(images))):\n",
        "\n",
        "        plt.subplot(3, 3, i + 1)\n",
        "\n",
        "        plt.imshow(images[i].numpy().astype(\"uint8\"))\n",
        "\n",
        "        plt.title(class_names[labels[i]])\n",
        "\n",
        "        plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 10. OPTIMIZE DATASET PERFORMANCE\n",
        "# ================================================================\n",
        "\n",
        "AUTOTUNE = tf.data.AUTOTUNE\n",
        "\n",
        "train_ds = train_ds.prefetch(\n",
        "    buffer_size=AUTOTUNE\n",
        ")\n",
        "\n",
        "val_ds = val_ds.prefetch(\n",
        "    buffer_size=AUTOTUNE\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 11. DATA AUGMENTATION\n",
        "# ================================================================\n",
        "\n",
        "data_augmentation = tf.keras.Sequential([\n",
        "\n",
        "    layers.RandomFlip(\n",
        "        \"horizontal\"\n",
        "    ),\n",
        "\n",
        "    layers.RandomRotation(\n",
        "        0.1\n",
        "    ),\n",
        "\n",
        "    layers.RandomZoom(\n",
        "        0.1\n",
        "    )\n",
        "\n",
        "], name=\"data_augmentation\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 12. LOAD PRE-TRAINED MOBILENETV2\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"LOADING PRE-TRAINED MOBILENETV2\")\n",
        "print(\"================================================\")\n",
        "\n",
        "base_model = tf.keras.applications.MobileNetV2(\n",
        "\n",
        "    input_shape=(\n",
        "        IMG_SIZE,\n",
        "        IMG_SIZE,\n",
        "        3\n",
        "    ),\n",
        "\n",
        "    include_top=False,\n",
        "\n",
        "    weights=\"imagenet\"\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 13. FREEZE PRE-TRAINED LAYERS\n",
        "# ================================================================\n",
        "\n",
        "base_model.trainable = False\n",
        "\n",
        "print(\"MobileNetV2 loaded successfully.\")\n",
        "print(\"Pre-trained convolutional layers are frozen.\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 14. MOBILENETV2 PREPROCESSING\n",
        "# ================================================================\n",
        "\n",
        "preprocess_input = (\n",
        "    tf.keras.applications.mobilenet_v2.preprocess_input\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 15. BUILD TRANSFER LEARNING MODEL\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"BUILDING TRANSFER LEARNING MODEL\")\n",
        "print(\"================================================\")\n",
        "\n",
        "inputs = tf.keras.Input(\n",
        "    shape=(\n",
        "        IMG_SIZE,\n",
        "        IMG_SIZE,\n",
        "        3\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# Data augmentation\n",
        "x = data_augmentation(inputs)\n",
        "\n",
        "\n",
        "# MobileNetV2 preprocessing\n",
        "x = preprocess_input(x)\n",
        "\n",
        "\n",
        "# Pre-trained MobileNetV2\n",
        "x = base_model(\n",
        "    x,\n",
        "    training=False\n",
        ")\n",
        "\n",
        "\n",
        "# Global Average Pooling\n",
        "x = layers.GlobalAveragePooling2D()(x)\n",
        "\n",
        "\n",
        "# Dropout\n",
        "x = layers.Dropout(\n",
        "    0.2\n",
        ")(x)\n",
        "\n",
        "\n",
        "# Classification layer\n",
        "outputs = layers.Dense(\n",
        "    len(class_names),\n",
        "    activation=\"softmax\"\n",
        ")(x)\n",
        "\n",
        "\n",
        "# Create final model\n",
        "model = models.Model(\n",
        "    inputs,\n",
        "    outputs\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 16. COMPILE MODEL\n",
        "# ================================================================\n",
        "\n",
        "model.compile(\n",
        "\n",
        "    optimizer=tf.keras.optimizers.Adam(\n",
        "        learning_rate=0.0001\n",
        "    ),\n",
        "\n",
        "    loss=\"sparse_categorical_crossentropy\",\n",
        "\n",
        "    metrics=[\n",
        "        \"accuracy\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 17. CHECK MODEL OUTPUT\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"MODEL INFORMATION\")\n",
        "print(\"================================================\")\n",
        "\n",
        "print(\n",
        "    \"Number of output classes:\",\n",
        "    len(class_names)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Output classes:\",\n",
        "    class_names\n",
        ")\n",
        "\n",
        "model.summary()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 18. TRAIN MODEL\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"TRAINING MODEL\")\n",
        "print(\"================================================\")\n",
        "\n",
        "EPOCHS = 10\n",
        "\n",
        "history = model.fit(\n",
        "\n",
        "    train_ds,\n",
        "\n",
        "    validation_data=val_ds,\n",
        "\n",
        "    epochs=EPOCHS\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 19. EVALUATE MODEL\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"MODEL EVALUATION\")\n",
        "print(\"================================================\")\n",
        "\n",
        "loss, accuracy = model.evaluate(\n",
        "    val_ds,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nValidation Loss:\",\n",
        "    round(loss, 4)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Validation Accuracy:\",\n",
        "    round(accuracy * 100, 2),\n",
        "    \"%\"\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 20. PLOT TRAINING ACCURACY AND VALIDATION ACCURACY\n",
        "# ================================================================\n",
        "\n",
        "acc = history.history[\"accuracy\"]\n",
        "\n",
        "val_acc = history.history[\"val_accuracy\"]\n",
        "\n",
        "loss_values = history.history[\"loss\"]\n",
        "\n",
        "val_loss = history.history[\"val_loss\"]\n",
        "\n",
        "epochs_range = range(\n",
        "    1,\n",
        "    EPOCHS + 1\n",
        ")\n",
        "\n",
        "\n",
        "plt.figure(\n",
        "    figsize=(14, 5)\n",
        ")\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# Accuracy\n",
        "# -----------------------------\n",
        "\n",
        "plt.subplot(\n",
        "    1,\n",
        "    2,\n",
        "    1\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    epochs_range,\n",
        "    acc,\n",
        "    marker=\"o\",\n",
        "    label=\"Training Accuracy\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    epochs_range,\n",
        "    val_acc,\n",
        "    marker=\"o\",\n",
        "    label=\"Validation Accuracy\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Epoch\")\n",
        "\n",
        "plt.ylabel(\"Accuracy\")\n",
        "\n",
        "plt.title(\n",
        "    \"Training and Validation Accuracy\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# Loss\n",
        "# -----------------------------\n",
        "\n",
        "plt.subplot(\n",
        "    1,\n",
        "    2,\n",
        "    2\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    epochs_range,\n",
        "    loss_values,\n",
        "    marker=\"o\",\n",
        "    label=\"Training Loss\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    epochs_range,\n",
        "    val_loss,\n",
        "    marker=\"o\",\n",
        "    label=\"Validation Loss\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Epoch\")\n",
        "\n",
        "plt.ylabel(\"Loss\")\n",
        "\n",
        "plt.title(\n",
        "    \"Training and Validation Loss\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 21. SAVE TRAINED MODEL\n",
        "# ================================================================\n",
        "\n",
        "model_path = \"flower_mobilenetv2_model.keras\"\n",
        "\n",
        "model.save(\n",
        "    model_path\n",
        ")\n",
        "\n",
        "print(\"\\n================================================\")\n",
        "print(\"MODEL SAVED\")\n",
        "print(\"================================================\")\n",
        "\n",
        "print(\n",
        "    \"Saved as:\",\n",
        "    model_path\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 22. UPLOAD NEW FLOWER IMAGE\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"================================================\")\n",
        "print(\"UPLOAD A FLOWER IMAGE\")\n",
        "print(\"================================================\")\n",
        "\n",
        "print(\n",
        "    \"Click 'Choose Files' and select a flower image.\"\n",
        ")\n",
        "\n",
        "uploaded = files.upload()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 23. PREDICT UPLOADED IMAGE\n",
        "# ================================================================\n",
        "\n",
        "for filename in uploaded.keys():\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"Processing image:\", filename)\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Open image\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    image = Image.open(\n",
        "        filename\n",
        "    ).convert(\"RGB\")\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Display uploaded image\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    plt.figure(\n",
        "        figsize=(7, 7)\n",
        "    )\n",
        "\n",
        "    plt.imshow(\n",
        "        image\n",
        "    )\n",
        "\n",
        "    plt.axis(\n",
        "        \"off\"\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        \"Uploaded Flower Image\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Resize image\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    image_resized = image.resize(\n",
        "        (\n",
        "            IMG_SIZE,\n",
        "            IMG_SIZE\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Convert image to NumPy array\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    img_array = np.array(\n",
        "        image_resized\n",
        "    ).astype(\n",
        "        np.float32\n",
        "    )\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Add batch dimension\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    img_array = np.expand_dims(\n",
        "        img_array,\n",
        "        axis=0\n",
        "    )\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Make prediction\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    predictions = model.predict(\n",
        "        img_array,\n",
        "        verbose=0\n",
        "    )[0]\n",
        "\n",
        "\n",
        "    # ------------------------------------------------\n",
        "    # Find predicted class\n",
        "    # ------------------------------------------------\n",
        "\n",
        "    predicted_index = np.argmax(\n",
        "        predictions\n",
        "    )\n",
        "\n",
        "    predicted_class = class_names[\n",
        "        predicted_index\n",
        "    ]\n",
        "\n",
        "    confidence = (\n",
        "        predictions[predicted_index]\n",
        "        * 100\n",
        "    )\n",
        "\n",
        "\n",
        "    # =================================================\n",
        "    # 24. DISPLAY PREDICTION RESULT\n",
        "    # =================================================\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"================================================\")\n",
        "    print(\"              FLOWER PREDICTION\")\n",
        "    print(\"================================================\")\n",
        "\n",
        "    print(\n",
        "        \"Uploaded Image   :\",\n",
        "        filename\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Predicted Flower :\",\n",
        "        predicted_class\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Confidence       : {:.2f}%\".format(\n",
        "            confidence\n",
        "        )\n",
        "    )\n",
        "\n",
        "    print(\"================================================\")\n",
        "\n",
        "\n",
        "    # =================================================\n",
        "    # 25. DISPLAY ALL CLASS PROBABILITIES\n",
        "    # =================================================\n",
        "\n",
        "    print(\"\\nPrediction probabilities:\")\n",
        "\n",
        "    for i, flower in enumerate(\n",
        "        class_names\n",
        "    ):\n",
        "\n",
        "        probability = (\n",
        "            predictions[i]\n",
        "            * 100\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"{:<15} : {:.2f}%\".format(\n",
        "                flower,\n",
        "                probability\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "    # =================================================\n",
        "    # 26. DISPLAY PROBABILITY BAR GRAPH\n",
        "    # =================================================\n",
        "\n",
        "    plt.figure(\n",
        "        figsize=(10, 5)\n",
        "    )\n",
        "\n",
        "    probabilities = (\n",
        "        predictions * 100\n",
        "    )\n",
        "\n",
        "    bars = plt.bar(\n",
        "        class_names,\n",
        "        probabilities,\n",
        "        color=\"green\"\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\n",
        "        \"Flower Category\"\n",
        "    )\n",
        "\n",
        "    plt.ylabel(\n",
        "        \"Probability (%)\"\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        \"Flower Classification Probabilities\"\n",
        "    )\n",
        "\n",
        "    plt.ylim(\n",
        "        0,\n",
        "        100\n",
        "    )\n",
        "\n",
        "    plt.xticks(\n",
        "        rotation=20\n",
        "    )\n",
        "\n",
        "\n",
        "    # Add percentage above bars\n",
        "    for bar, probability in zip(\n",
